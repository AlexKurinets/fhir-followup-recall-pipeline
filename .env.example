# Copy to .env to override the defaults used by docker-compose.yml.

# Pin the demo's "today" (YYYY-MM-DD). Empty means the real date.
AS_OF=

# Resources the simulated tenant hides from its FHIR API. Set to an empty value to expose everything,
# which switches appointments from the staff export to FHIR with no other change.
HIDDEN_RESOURCES=Appointment

# Who the dashboard records as the acting user in the access log.
DEMO_ACTOR=dana.reyes@example.com

# phrase-list (default, offline) or claude. The claude matcher sends note text to the model endpoint,
# so only use it against an endpoint covered by a BAA, and never with real patient data in this demo.
MATCHER=phrase-list
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
